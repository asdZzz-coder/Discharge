<Window x:Class="Discharge.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="匯入 Excel" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <StackPanel Margin="24,20,24,18">
        <TextBlock Text="匯入 Excel" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="FileText" Style="{StaticResource HintText}" Margin="0,4,0,14" />

        <!-- 檔案內容 -->
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="檔案裡有" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="SummaryText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="NoticeText" Style="{StaticResource HintText}" Margin="0,6,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- 匯入方式 -->
        <TextBlock Text="匯入方式" Style="{StaticResource FieldLabel}" />
        <RadioButton x:Name="MergeOption" Style="{StaticResource OptionCard}" GroupName="Mode" IsChecked="True" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="合併" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,3,0,0"
                           Text="料號相同的物料用檔案的內容更新，工令和機台名稱相同的表單，料以檔案為準。檔案裡沒有的資料保留。" />
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="ReplaceOption" Style="{StaticResource OptionCard}" GroupName="Mode">
            <StackPanel>
                <TextBlock Text="完全以 Excel 為準" FontWeight="SemiBold" />
                <TextBlock x:Name="ReplaceText" Style="{StaticResource HintText}" Margin="0,3,0,0" />
            </StackPanel>
        </RadioButton>

        <TextBlock Style="{StaticResource HintText}" Margin="2,12,0,0"
                   Text="匯入前會自動備份目前的資料。" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" IsCancel="True" Margin="0,0,8,0" Padding="18,9" />
            <Button Style="{StaticResource PrimaryButton}" Click="Ok_Click" Padding="20,9" x:Name="OkButton">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B5;" Style="{StaticResource ButtonIcon}" />
                    <TextBlock Text="開始匯入" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
