<Window x:Class="Discharge.Views.MaterialPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="從資料庫選料" Height="640" Width="1000" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft JhengHei UI" FontSize="14">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="搜尋" Style="{StaticResource FieldLabel}" />
            <CheckBox DockPanel.Dock="Right" x:Name="OnlySelectedBox" Content="只看已勾選" VerticalAlignment="Center" Margin="12,0,0,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <Button DockPanel.Dock="Right" Content="全部取消勾選" Click="ClearAll_Click" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="勾選篩選出來的全部" Click="SelectAll_Click" Margin="12,0,0,0" />
            <TextBox x:Name="SearchBox" TextChanged="Filter_Changed"
                     ToolTip="搜尋料號、名稱、規格、備註；空格分開可以打好幾個關鍵字" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,8"
                   Text="勾選要出的料（可以多選），數量可以直接改；換搜尋條件時已經勾的會留著。選取好幾列後按空白鍵可以一次勾選或取消。" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="加入表單" Click="Ok_Click" FontWeight="Bold" Margin="0,0,8,0" />
                <Button Content="取消" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" />
        </DockPanel>

        <DataGrid x:Name="RowsGrid" SelectionMode="Extended" PreviewKeyDown="RowsGrid_PreviewKeyDown">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter Property="Background" Value="#E3F2E9" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="選" Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="料號" Binding="{Binding Material.PartNo}" IsReadOnly="True" Width="140" />
                <DataGridTextColumn Header="名稱" Binding="{Binding Material.Name}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="規格" Binding="{Binding Material.Spec}" IsReadOnly="True" Width="1.3*" />
                <DataGridTextColumn Header="備註" Binding="{Binding Material.Note}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="數量" Binding="{Binding Quantity}" Width="70" />
                <DataGridTextColumn Header="" Binding="{Binding Status}" IsReadOnly="True" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#B26A00" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
