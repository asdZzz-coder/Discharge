<Window x:Class="Discharge.Views.MaterialPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="從資料庫選料" Height="680" Width="1040" MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <DockPanel Margin="24,20,24,18">
        <!-- 標題 -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="從資料庫選料" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                       Text="料號、名稱、規格可以同時篩選（空格分開可以打好幾個關鍵字）。勾選要出的料（可以多選），數量可以直接改。換篩選條件時已經勾的會留著；選取好幾列後按空白鍵可以一次勾選或取消。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 底部：已勾選數量、加入 / 取消 -->
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}" Background="{StaticResource AccentSoftBrush}" BorderBrush="Transparent" Padding="10,3">
                    <TextBlock x:Name="SelectedCountText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                </Border>
                <TextBlock x:Name="SummaryText" Style="{StaticResource HintText}" Margin="10,0,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="取消" IsCancel="True" Margin="0,0,8,0" Padding="18,9" />
            <Button Grid.Column="2" x:Name="OkButton" Style="{StaticResource PrimaryButton}" Click="Ok_Click" Padding="20,9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource ButtonIcon}" FontSize="12" />
                    <TextBlock x:Name="OkText" Text="加入表單" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="16">
            <DockPanel>
                <!-- 分欄篩選：料號、名稱、規格各打各的，同時符合才列出 -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="料號" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PartNoFilterBox" Style="{StaticResource SearchBox}" Tag="篩選料號…" TextChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="名稱" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameFilterBox" Style="{StaticResource SearchBox}" Tag="篩選名稱…" TextChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="規格" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SpecFilterBox" Style="{StaticResource SearchBox}" Tag="篩選規格…" TextChanged="Filter_Changed" />
                    </StackPanel>
                    <Button Grid.Column="5" x:Name="ClearFilterButton" Style="{StaticResource GhostButton}" Click="ClearFilter_Click"
                            VerticalAlignment="Bottom" Margin="10,0,0,0" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE894;" Style="{StaticResource ButtonIcon}" />
                            <TextBlock Text="清除篩選" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 搜尋與勾選工具 -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="Filter_Changed"
                             Tag="搜尋全部欄位（含備註）" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Click="SelectAll_Click" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE762;" Style="{StaticResource ButtonIcon}" />
                            <TextBlock Text="勾選篩選出來的全部" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="ClearAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" Style="{StaticResource ButtonIcon}" />
                            <TextBlock Text="全部取消" />
                        </StackPanel>
                    </Button>
                    <CheckBox Grid.Column="3" x:Name="OnlySelectedBox" Content="只看已勾選" FontSize="13" Margin="10,0,4,0"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" />
                </Grid>

                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="1">
                    <Grid>
                        <DataGrid x:Name="RowsGrid" SelectionMode="Extended" IsSynchronizedWithCurrentItem="False" PreviewKeyDown="RowsGrid_PreviewKeyDown">
                            <DataGrid.RowStyle>
                                <!-- 選取的列用灰色、勾選的列用綠色，兩種才分得出來 -->
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Selected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="48" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="料號" Binding="{Binding Material.PartNo}" IsReadOnly="True" Width="140"
                                                    ElementStyle="{StaticResource StrongCell}" />
                                <DataGridTextColumn Header="名稱" Binding="{Binding Material.Name}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="規格" Binding="{Binding Material.Spec}" IsReadOnly="True" Width="1.3*"
                                                    ElementStyle="{StaticResource MutedCell}" />
                                <DataGridTextColumn Header="備註" Binding="{Binding Material.Note}" IsReadOnly="True" Width="*"
                                                    ElementStyle="{StaticResource MutedCell}" />
                                <DataGridTextColumn Header="數量" Binding="{Binding Quantity}" Width="76" HeaderStyle="{StaticResource NumberHeader}"
                                                    ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTemplateColumn Header="" IsReadOnly="True" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Tag" Style="{StaticResource Chip}" HorizontalAlignment="Left"
                                                    Background="{StaticResource WarningSoftBrush}" BorderBrush="#FDE68A">
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource ChipText}" Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="">
                                                    <Setter TargetName="Tag" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource EmptyText}" Text="找不到符合的物料" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
