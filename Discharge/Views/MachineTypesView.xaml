<UserControl x:Class="Discharge.Views.MachineTypesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：機種清單 -->
        <Border Style="{StaticResource Card}" Padding="14,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,12">
                    <TextBlock Text="機種" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                        <TextBlock x:Name="TypeCountText" Style="{StaticResource ChipText}" />
                    </Border>
                </StackPanel>
                <TextBox DockPanel.Dock="Top" x:Name="TypeSearchBox" Style="{StaticResource SearchBox}"
                         Tag="搜尋機種…" Margin="0,0,0,10" TextChanged="TypeSearch_TextChanged" />
                <Grid>
                    <ListBox x:Name="TypeList" Style="{StaticResource SideList}" IsSynchronizedWithCurrentItem="False"
                             SelectionChanged="TypeList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding UsageText}" FontSize="12.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="TypeEmptyText" Style="{StaticResource EmptyText}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- 右：新增、改名、刪除 -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="新增機種" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,14"
                               Text="機種加好後，到「功能規則」設定每條規則的適用機種，機台表單選了機種就只會列出能用的功能。" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="360" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewTypeNameBox" KeyDown="NewTypeNameBox_KeyDown" ToolTip="輸入機種名稱，按 Enter 或「新增」" />
                        <Button Grid.Column="1" x:Name="AddTypeButton" Style="{StaticResource PrimaryButton}" Click="Add_Click" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource ButtonIcon}" FontSize="12" />
                                <TextBlock Text="新增" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" FontSize="12" Text="機種數量沒有上限；名稱不能重複（不分大小寫），也不能有「、」。" />

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,22,0,20" />

                    <TextBlock x:Name="NoSelectionText" Style="{StaticResource HintText}" Text="點左邊的機種，可以改名或刪除。" />

                    <StackPanel x:Name="SelectedPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedTitle" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" x:Name="DeleteTypeButton" Style="{StaticResource DangerButton}" Click="Delete_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource ButtonIcon}" />
                                    <TextBlock Text="刪除機種" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="機種名稱" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="360" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RenameBox" KeyDown="RenameBox_KeyDown" />
                            <Button Grid.Column="1" x:Name="RenameButton" Click="Rename_Click" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AC;" Style="{StaticResource ButtonIcon}" />
                                    <TextBlock Text="改名" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Style="{StaticResource HintText}" FontSize="12" Margin="0,0,0,18"
                                   Text="改名時，規則的適用機種和機台表單上的機種會一起改。" />

                        <Border Style="{StaticResource InfoBox}">
                            <StackPanel>
                                <TextBlock Text="用到這個機種的" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock x:Name="RuleUsageText" TextWrapping="Wrap" />
                                <TextBlock x:Name="MachineUsageText" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
