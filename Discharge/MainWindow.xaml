<Window x:Class="Discharge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discharge" Height="720" Width="1200" MinHeight="480" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft JhengHei UI" FontSize="14"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <!-- 狀態列：訊息、版本與更新 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="檢查更新" Padding="12,3" Click="CheckUpdate_Click" />
                <TextBlock DockPanel.Dock="Right" x:Name="StatusText" VerticalAlignment="Center" Foreground="#666666" Margin="12,0" />
                <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" Margin="8,8,8,4">
            <!-- ========== 機台表單 ========== -->
            <TabItem Header="  機台表單  ">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：機台清單 -->
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="＋ 新增機台" Click="NewMachine_Click" />
                            <TextBlock Text="機台" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="搜尋" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="MachineSearchBox" TextChanged="MachineSearch_TextChanged"
                                     ToolTip="搜尋工令、機台名稱，或表單上的料號、名稱、規格；空格分開可以打好幾個關鍵字" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" x:Name="MachineCountText" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                        <DataGrid x:Name="MachineGrid" IsReadOnly="True" SelectionMode="Single"
                                  SelectionChanged="MachineGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="工令" Binding="{Binding WorkOrder}" Width="*" />
                                <DataGridTextColumn Header="機台名稱" Binding="{Binding Name}" Width="1.4*" />
                                <DataGridTextColumn Header="料件" Binding="{Binding ItemCount}" Width="50" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- 右：機台表單 -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" x:Name="FormTitle" Style="{StaticResource SectionTitle}" Margin="0,4,0,12" />

                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="工令 *" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="WorkOrderBox" />
                            <TextBlock Grid.Column="3" Text="機台名稱 *" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="4" x:Name="MachineNameBox" />
                        </Grid>

                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button DockPanel.Dock="Left" x:Name="DeleteMachineButton" Content="刪除機台" Click="DeleteMachine_Click" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="還原變更" Click="RevertMachine_Click" Margin="0,0,8,0" />
                                <Button Content="儲存（Ctrl+S）" Click="SaveMachine_Click" FontWeight="Bold" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="從資料庫選料…" Click="PickMaterials_Click" FontWeight="Bold" />
                            <Button Content="移除選取的料" Click="RemoveItems_Click" Margin="8,0,0,0" />
                            <TextBlock x:Name="ItemCountText" Style="{StaticResource HintText}" Margin="12,0,0,0" />
                        </DockPanel>

                        <DataGrid x:Name="ItemGrid" SelectionMode="Extended">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="料號" Binding="{Binding PartNo}" IsReadOnly="True" Width="140" />
                                <DataGridTextColumn Header="名稱" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="規格" Binding="{Binding Spec}" IsReadOnly="True" Width="1.3*" />
                                <DataGridTextColumn Header="數量" Binding="{Binding Quantity}" Width="70" />
                                <DataGridTextColumn Header="備註" Binding="{Binding Note}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ========== 物料資料庫 ========== -->
            <TabItem Header="  物料資料庫  ">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：物料清單 -->
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="搜尋" Style="{StaticResource FieldLabel}" />
                            <Button DockPanel.Dock="Right" Content="刪除選取的物料" Click="DeleteMaterials_Click" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="從剪貼簿貼上" Click="PasteMaterials_Click" Margin="8,0,0,0"
                                    ToolTip="在 Excel 選好範圍按 Ctrl+C，再按這個按鈕一次加入很多項" />
                            <TextBlock DockPanel.Dock="Right" x:Name="MaterialCountText" Style="{StaticResource HintText}" Margin="12,0,4,0" />
                            <TextBox x:Name="MaterialSearchBox" TextChanged="MaterialSearch_TextChanged"
                                     ToolTip="搜尋料號、名稱、規格、備註；空格分開可以打好幾個關鍵字" />
                        </DockPanel>
                        <DataGrid x:Name="MaterialGrid" IsReadOnly="True" SelectionMode="Extended"
                                  SelectionChanged="MaterialGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="料號" Binding="{Binding PartNo}" Width="150" />
                                <DataGridTextColumn Header="名稱" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="規格" Binding="{Binding Spec}" Width="1.3*" />
                                <DataGridTextColumn Header="備註" Binding="{Binding Note}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- 右：新增 / 修改物料 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="MaterialFormTitle" Style="{StaticResource SectionTitle}" Margin="0,4,0,12" />
                        <TextBlock Text="料號 *" Margin="0,0,0,4" />
                        <TextBox x:Name="PartNoBox" Margin="0,0,0,10" />
                        <TextBlock Text="名稱 *" Margin="0,0,0,4" />
                        <TextBox x:Name="MaterialNameBox" Margin="0,0,0,10" />
                        <TextBlock Text="規格" Margin="0,0,0,4" />
                        <TextBox x:Name="SpecBox" Margin="0,0,0,10" />
                        <TextBlock Text="備註" Margin="0,0,0,4" />
                        <TextBox x:Name="MaterialNoteBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="新增" Click="AddMaterial_Click" FontWeight="Bold" />
                            <Button x:Name="UpdateMaterialButton" Content="儲存修改" Click="UpdateMaterial_Click" Margin="8,0,0,0" />
                            <Button Content="清空" Click="ClearMaterialForm_Click" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,16,0,0"
                                   Text="點清單上的物料可以修改。按「新增」會用表單內容新增一項，可以拿現有的物料改一改再新增。" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                   Text="修改或刪除物料不會改到已經建好的機台表單。" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
